# =============================================================================
# Unity .gitignore — TagGame
# =============================================================================

# Unity-generated folders (all rebuildable from source + Packages/manifest.json)
# Anchored to the repo root (leading slash) so a WebGL build output folder
# named "WebBuild/Build/" elsewhere in the tree is never accidentally matched.
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/

# Never ship these
[Aa]ssets/AssetStoreTools*
[Aa]ssets/Plugins/Editor/JetBrains*

# Visual Studio / Rider / VS Code generated
.vs/
.vscode/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files that shouldn't be versioned on their own
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics generated file
crashlytics-build.properties

# Packed Addressables
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Plastic SCM (Unity's default VCS) — not used, we're using git instead
.plastic/
*.plastic.meta

# OS files
.DS_Store
Thumbs.db
